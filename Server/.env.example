# MongoDB connection string (Atlas or local).
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/turjofolio?retryWrites=true&w=majority
# Example local: mongodb://127.0.0.1:27017/turjofolio
MONGODB_URI=

# Comma separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
